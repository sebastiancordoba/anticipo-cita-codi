# simulado = no llama a pey; el botón "Simular pago" firma y manda un webhook falso a /api/webhooks/pey
# real     = llama a https://api.pey.mx con PEY_API_KEY
PEY_MODE=simulado
PEY_API_KEY=
# Secreto del webhook (Standard Webhooks; el de pey empieza con whsec_). En modo simulado puede ser cualquier base64.
PEY_WEBHOOK_SECRET=c2ltdWxhZG8tbm8tZXMtdW4tc2VjcmV0bw==
# Monto del anticipo en MXN (para pruebas reales usar 0.01)
ANTICIPO_MXN=0.01
# Minutos que se aparta el horario mientras llega el pago (mínimo 6 por CoDi)
MINUTOS_APARTADO=10
